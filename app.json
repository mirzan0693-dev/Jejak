{
  "expo": {
    "name": "Jejak",
    "slug": "jejak",
    "version": "1.0.0",
    "scheme": "jejak",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1416",
    "ios": {
      "bundleIdentifier": "com.mirzan.jejak",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mirzan.jejak",
      "adaptiveIcon": {
        "backgroundColor": "#0F1416",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jejak shows your location to the people you approve, and helps you find this phone.",
          "locationAlwaysAndWhenInUsePermission": "Allow \"Always\" so the people you approve see where you are, and you can find this phone, even when Jejak is closed. You can stop sharing at any time.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2BB673"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jejak uses a photo you choose as your profile picture, shown only to people you share with.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-dev-client"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Jejak",
      "shortName": "Jejak",
      "favicon": "./public/icon-192.png",
      "backgroundColor": "#0F1416"
    }
  }
}
